{
  "name": "bakeoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model bake-off harness. Implements the protocol in docs/research/03-model-decision-final.md section 7: sealed held-out acceptance gate, co-primary held_out_pass / false_finish metrics, out-of-process hard cost ceiling, per-vendor token accounting.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bakeoff": "npm run build --silent && node dist/cli.js",
    "test": "npm run build --silent && node --test dist/*.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@playwright/test": "1.62.0"
  }
}
