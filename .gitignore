node_modules/
dist/
.next/
*.tsbuildinfo
next-env.d.ts

# PER-AGENT BUILD OUTPUTS. `dist/` above does NOT cover these.
#
# When several agents work this tree at once they cannot share `dist/`: one
# agent's `npm run build` clobbers another's compiled tests mid-run, and the
# failure looks like a test regression rather than a collision. The house
# workaround is a private outDir per agent — `dist-2b`, `dist-calfix` — which
# `dist/` does not match, so 3.4 MB of compiled output sat untracked and one
# `git add -A` away from the repository.
#
# The name is not free-form: `contract-parity.test.ts` resolves the client
# package relative to `import.meta.dirname` and documents that every outDir this
# repo uses sits at `dashboard/server/<outDir>` for exactly that reason. So the
# pattern is a SIBLING of `dist`, deliberately — a nested outDir would break
# that test rather than be caught by this rule.
dist-*/

# Run state and artefacts — never in version control.
dashboard/data/
dashboard/runs/
dashboard/results/
dashboard/screenshots/
bakeoff/dist/
bakeoff/results/
bakeoff/dry-run/
bakeoff/.scorer-modes-e2e/

# THE SEALED ACCEPTANCE SUITE. Held out on purpose — committing it would put
# the held-out tests in reach of anything that reads the repo.
dashboard/acceptance/

# The client suite's own build dir and artefacts. `npm test` runs a SECOND
# `next dev` — Next 16 refuses to share a build directory between two dev
# servers — and Playwright writes failure context under `test-results/`.
dashboard/.next-test/
dashboard/test-results/

# Tooling scratch
.debugfix-active
.debugfix-blocks
.playwright-mcp/

# Secrets — never committed. See ~/.claude/scripts/set-secret.sh
.env
.env.*
!.env.example

# Published project artefacts. Copies of run workspaces, written by
# `project-publish.ts` so the owner can find his code without a 44-character
# run id. The run keeps its own copy under dashboard/runs/<id>/workspace/.
/projects/

# Agent evidence screenshots. Reviewers and adversaries drop PNGs beside the file
# they were testing, and a `git add -A` sweeps them into the repo root — six
# arrived that way in 53824b7 and one in an earlier commit. They are evidence for
# a report, not source, and this repo is public. Scoped to the ROOT so a real
# asset under dashboard/ or projects/ is unaffected.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Agent scratch from the design lanes: Gemini iteration frames, mock harnesses and
# throwaway screenshot scripts. The shipped marks live in dashboard/public/rail/ and
# the reasoning lives in docs/superpowers/specs/; these are the frames that did not
# make it, ~4MB of them, and carrying every rejected draft in history forever costs
# more than the provenance is worth.
/.tmp-design-lead/
/design-refs/
