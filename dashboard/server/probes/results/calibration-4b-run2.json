        "id": "REQ-001",
        "tier": "BLOCKING",
        "statement": "When the delivered site is requested at the configured loopback base URL, the portfolio site shall return HTTP 200 for GET / with a text/html content type and a complete HTML document of at least 400 bytes."
      },
      {
        "id": "REQ-002",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall reference at least one stylesheet, as a same-origin linked file or an inline style block of at least 200 characters, and shall resolve every same-origin asset referenced by the root document with a status below 400 and every same-origin page link with a status below 500."
      },
      {
        "id": "REQ-003",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall serve HTML, CSS and JavaScript free of unfinished-work markers such as 'lorem ipsum', 'coming soon', 'under construction', 'placeholder text' or source-comment work markers."
      },
      {
        "id": "REQ-004",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall render a hero region at the top of the home page containing a visible level-one heading whose normalised text includes 'Ada Lovelace' at a computed font size of at least 24 CSS pixels."
      },
      {
        "id": "REQ-005",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall render a projects section containing at least three project entries with distinct titles, each accompanied by at least 40 characters of descriptive text."
      },
      {
        "id": "REQ-006",
        "tier": "FUNCTIONAL",
        "statement": "When a visitor fills and submits the contact form, which shall expose an email field, a message field and a submit control, the portfolio site shall display on a same-origin page a confirmation message that was not present before submission."
      },
      {
        "id": "REQ-007",
        "tier": "QUALITY",
        "statement": "The portfolio site shall serve a home page carrying a language attribute on the html element, a non-empty document title, exactly one level-one heading, an alt attribute on every visible image, and an accessible name for every visible form control."
      },
      {
        "id": "REQ-008",
        "tier": "QUALITY",
        "statement": "While the viewport is 390x844, 768x1024 or 1280x800 CSS pixels, the portfolio site shall render the home page without horizontal document overflow and shall keep the hero heading and the contact form visible."
      },
      {
        "id": "REQ-009",
        "tier": "QUALITY",
        "statement": "If the contact form is submitted with its fields left blank, then the portfolio site shall not display a submission confirmation message."
      },
      {
        "id": "REQ-010",
        "tier": "QUALITY",
        "statement": "The portfolio site shall present at least 800 characters of visible body text that includes at least two distinct Ada Lovelace specific references, such as the Analytical Engine, Babbage, Bernoulli numbers or the 1843 Notes, and no generic template placeholder wording."
      }
