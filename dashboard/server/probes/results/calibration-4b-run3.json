        "id": "REQ-001",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall serve the root document at / with HTTP 200 and an HTML body of at least 500 bytes."
      },
      {
        "id": "REQ-002",
        "tier": "BLOCKING",
        "statement": "When the root document references a same-origin link, stylesheet, script or image, the portfolio site shall answer that reference with an HTTP status below 400, and every in-page anchor shall resolve to an element present in the rendered document."
      },
      {
        "id": "REQ-003",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall deliver markup, stylesheets and scripts that contain no stub or placeholder markers."
      },
      {
        "id": "REQ-004",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall display the name Ada Lovelace in a hero heading that is rendered visibly within the first 800 pixels of the home page at a 1280x800 viewport, as the h1 or at a computed font size of at least 28 pixels."
      },
      {
        "id": "REQ-005",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall present a projects section containing at least three visible project entries, each carrying a distinct title and a distinct description of at least 40 characters."
      },
      {
        "id": "REQ-006",
        "tier": "FUNCTIONAL",
        "statement": "When a visitor fills the contact form fields and activates its submit control, the portfolio site shall display on the same loopback origin a confirmation message that was not visible before the submission."
      },
      {
        "id": "REQ-007",
        "tier": "QUALITY",
        "statement": "The portfolio site shall render the home page with a non-empty document lang attribute, exactly one h1, an alt attribute on every image, and an accessible name on every visible form control."
      },
      {
        "id": "REQ-008",
        "tier": "QUALITY",
        "statement": "While the viewport is 375, 768 or 1440 CSS pixels wide, the portfolio site shall render the home page without horizontal overflow, with body text of at least 14 pixels and the name still visible."
      },
      {
        "id": "REQ-009",
        "tier": "QUALITY",
        "statement": "If the contact form is submitted with every field left empty, then the portfolio site shall not display a submission confirmation."
      },
      {
        "id": "REQ-010",
        "tier": "QUALITY",
        "statement": "Where bespoke rather than templated content is required, the portfolio site shall render a document title naming Ada, at least 800 characters of applied CSS, no generic Project One style headings, and copy naming at least two specifics of Ada Lovelace's work."
      }
    ],
