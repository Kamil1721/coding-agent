      {
        "id": "REQ-001",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall answer an HTTP GET for the site root with status 200, an HTML content type and a document body of at least 200 characters."
      },
      {
        "id": "REQ-002",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall serve and render no stub or placeholder filler markers in its delivered document or its rendered text."
      },
      {
        "id": "REQ-003",
        "tier": "BLOCKING",
        "statement": "The portfolio site shall answer every same-origin resource referenced by the home page with a status below 400 and shall answer an unknown same-origin path without a 5xx status."
      },
      {
        "id": "REQ-004",
        "tier": "FUNCTIONAL",
        "statement": "When a visitor opens the site root, the portfolio site shall display the name Ada Lovelace as its largest rendered text at a computed font size of at least 28 pixels and within the first 900 pixels of the page."
      },
      {
        "id": "REQ-005",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall present a projects section containing at least three project entries with distinct titles, each entry carrying at least 40 characters of its own descriptive text and no repeated description."
      },
      {
        "id": "REQ-006",
        "tier": "FUNCTIONAL",
        "statement": "The portfolio site shall provide a contact form containing a visible editable email field, a visible message field and a visible enabled submit control."
      },
      {
        "id": "REQ-007",
        "tier": "FUNCTIONAL",
        "statement": "When a visitor submits the contact form with valid details, the portfolio site shall display confirmation text that was not present on the page before the submission."
      },
      {
        "id": "REQ-008",
        "tier": "QUALITY",
        "statement": "The portfolio site shall render exactly one h1, an alt attribute on every image, an accessible name on every visible form control and a lang attribute on the html element."
      },
      {
        "id": "REQ-009",
        "tier": "QUALITY",
        "statement": "While the viewport is 375 pixels wide, the portfolio site shall render without horizontal document overflow and shall keep the name Ada Lovelace inside the viewport."
      },
      {
        "id": "REQ-010",
        "tier": "QUALITY",
        "statement": "If a visitor submits the contact form with its fields left empty, then the portfolio site shall withhold the submission confirmation and shall mark at least one field as required or surface a validation message."
      },
      {
        "id": "REQ-011",
        "tier": "QUALITY",
        "statement": "The portfolio site shall set a document title naming Ada, a meta description of at least 40 characters and a body font family other than the browser default."
      },
      {
        "id": "REQ-012",
        "tier": "QUALITY",
        "statement": "When the home page loads, the portfolio site shall raise no uncaught JavaScript page errors."
      }
