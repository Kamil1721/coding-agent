{
  "name": "dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The run service and HTTP API behind the local ticket dashboard. Drives the subscription-authenticated subprocess SDKs (Claude Agent SDK, Codex SDK) and reuses the bakeoff harness's spec agent, tier-0 gates and sealed scorer. Binds 127.0.0.1 only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build --silent && node dist/index.js",
    "test": "npm run build --silent && node --test \"dist/**/*.test.js\"",
    "cron:tick": "node dist/cron/cron-tick.js",
    "cron:report": "node dist/cron/cron-report.js",
    "test:harness": "npm run build --silent && node --test gemini-video-harness.mjs",
    "test:all": "npm run test && npm run test:harness",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@openai/codex-sdk": "0.145.0",
    "bakeoff": "file:../../bakeoff"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "5.9.3"
  }
}
